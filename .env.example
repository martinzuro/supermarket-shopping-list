# Copia este archivo a .env.local y completa los valores. No subas .env.local.
# En local, los valores salen de `npx supabase status` una vez que exista el
# stack local de Supabase.

# URL del proyecto de Supabase (API).
NEXT_PUBLIC_SUPABASE_URL=

# Clave publicable (publishable key) de Supabase, segura para el cliente.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Los dos valores se incrustan en el build (NEXT_PUBLIC_): al cambiarlos hay
# que volver a compilar. Las URLs de redirección del enlace de acceso
# (<origen>/auth/callback) se configuran en Supabase Auth, no acá.
